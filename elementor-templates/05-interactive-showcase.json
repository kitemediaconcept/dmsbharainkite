{
  "version": "0.4",
  "title": "DMS - Interactive 3D Showcase (Drift Wall & Documents Folder)",
  "type": "section",
  "content": [
    {
      "id": "sec_j0nqv0h",
      "elType": "section",
      "isInner": false,
      "settings": {
        "layout": "full_width",
        "gap": "no",
        "structure": "10"
      },
      "elements": [
        {
          "id": "col_pdoyj6s",
          "elType": "column",
          "isInner": false,
          "settings": {
            "_column_size": 100
          },
          "elements": [
            {
              "id": "wid_iemsq8c",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<style>\n    /* ==========================================================================\n       DMS DUAL INTERACTIVE FEATURE SHOWCASE SECTION (Drift Wall & Folder)\n       ========================================================================== */\n    .dms-section,\n    .dms-section *,\n    .dms-preview,\n    .dms-preview * {\n      box-sizing: border-box;\n    }\n\n    .dms-section {\n      width: 100%;\n      max-width: 1368px;\n      margin: 0 auto;\n      padding: 40px 24px;\n      font-family: Inter, \"Inter Placeholder\", sans-serif;\n      color: #111;\n    }\n\n    .dms-grid {\n      display: grid;\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      gap: 36px;\n    }\n\n    .dms-card {\n      position: relative;\n      display: flex;\n      flex-direction: column;\n      min-width: 0;\n      min-height: 580px;\n      overflow: hidden;\n      border-radius: 14px;\n      background: linear-gradient(135deg, #f3faf5 0%, #e1f0e6 100%);\n    }\n\n    .dms-card-content {\n      position: relative;\n      z-index: 2;\n      flex-shrink: 0;\n      padding: 40px 40px 16px;\n    }\n\n    .dms-label {\n      margin: 0 0 10px;\n      font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n      font-size: 11px;\n      line-height: 16px;\n      letter-spacing: 0.6px;\n      color: #54705e;\n    }\n\n    .dms-heading {\n      margin: 0 0 18px;\n      font-size: clamp(25px, 2.3vw, 32px);\n      font-weight: 400;\n      line-height: 1.22;\n      letter-spacing: -1.2px;\n      color: #111;\n    }\n\n    .dms-tagline {\n      max-width: 440px;\n      margin: 0 0 18px;\n      font-size: 16px;\n      font-weight: 500;\n      line-height: 24px;\n      letter-spacing: -0.48px;\n      color: #58675d;\n    }\n\n    .dms-link {\n      display: inline-flex;\n      align-items: center;\n      gap: 4px;\n      min-height: 44px;\n      margin-block: -8px;\n      padding-block: 8px;\n      font-size: 16px;\n      font-weight: 500;\n      line-height: 19px;\n      letter-spacing: -0.48px;\n      color: #256344;\n      text-decoration: none;\n    }\n\n    .dms-link span {\n      text-decoration: underline;\n      text-decoration-color: #9fbea9;\n      text-underline-offset: 4px;\n      text-decoration-thickness: 1px;\n    }\n\n    .dms-link svg {\n      width: 16px;\n      height: 16px;\n      flex: 0 0 16px;\n      fill: none;\n      stroke: currentColor;\n      stroke-width: 1.7;\n      stroke-linecap: round;\n      stroke-linejoin: round;\n      transition: transform 200ms ease;\n    }\n\n    .dms-link:focus-visible {\n      outline: 2px solid #256344;\n      outline-offset: 4px;\n      border-radius: 3px;\n    }\n\n    /* LEFT CARD: DRIFT WALL */\n    .dms-drift {\n      --tile-width: 155px;\n      --tile-height: 105px;\n      --tile-gap: 16px;\n\n      position: relative;\n      flex: 1;\n      min-height: 320px;\n      overflow: hidden;\n      isolation: isolate;\n\n      -webkit-mask-image: linear-gradient(\n        to bottom,\n        transparent 0%,\n        #000 25%,\n        #000 80%,\n        transparent 100%\n      );\n      mask-image: linear-gradient(\n        to bottom,\n        transparent 0%,\n        #000 25%,\n        #000 80%,\n        transparent 100%\n      );\n    }\n\n    .dms-drift-scene {\n      position: absolute;\n      inset: 0;\n      overflow: hidden;\n      perspective: 1200px;\n    }\n\n    .dms-drift-plane {\n      position: absolute;\n      top: 50%;\n      left: 50%;\n      display: flex;\n      gap: var(--tile-gap);\n      width: max-content;\n      height: 160%;\n      transform-style: preserve-3d;\n      transform:\n        translate(-50%, -50%)\n        scale(1.18)\n        rotateX(16deg)\n        rotateY(-14deg)\n        translateZ(-120px);\n    }\n\n    .dms-drift-column {\n      flex: 0 0 var(--tile-width);\n      width: var(--tile-width);\n    }\n\n    .dms-drift-track {\n      display: flex;\n      flex-direction: column;\n      gap: var(--tile-gap);\n      will-change: transform;\n    }\n\n    .dms-drift-tile {\n      flex: 0 0 var(--tile-height);\n      width: var(--tile-width);\n      height: var(--tile-height);\n      overflow: hidden;\n      border-radius: 14px;\n      background: linear-gradient(135deg, #dcebe0, #a7c8b2);\n      box-shadow: 0 5px 16px rgb(23 52 34 / 10%);\n    }\n\n    .dms-drift-tile img {\n      display: block;\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n    }\n\n    /* RIGHT CARD: FOLDER */\n    .dms-folder-area {\n      flex: 1;\n      min-height: 370px;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: flex-end;\n      padding: 125px 16px 28px;\n      overflow: hidden;\n      background: radial-gradient(\n        ellipse at 50% 70%,\n        rgba(37, 99, 68, 0.12),\n        transparent 65%\n      );\n    }\n\n    .dms-folder {\n      position: relative;\n      width: min(270px, 74%);\n      aspect-ratio: 270 / 190;\n      flex-shrink: 0;\n      perspective: 1100px;\n      isolation: isolate;\n    }\n\n    .dms-folder-back {\n      position: absolute;\n      inset: 0;\n      border-radius: 12px;\n      background: linear-gradient(150deg, #3984ee, #1c59b1);\n      box-shadow: 0 18px 32px -18px rgba(22, 54, 100, 0.4);\n    }\n\n    .dms-folder-back::before {\n      content: \"\";\n      position: absolute;\n      right: 0;\n      top: -23px;\n      width: 46%;\n      height: 35px;\n      border-radius: 12px 12px 0 0;\n      background: #3984ee;\n    }\n\n    .dms-folder-back > span {\n      position: absolute;\n      top: -16px;\n      right: 15px;\n      z-index: 1;\n      color: #fff;\n      font-size: 11px;\n      font-weight: 500;\n    }\n\n    .dms-folder-papers {\n      position: absolute;\n      inset: 0;\n      z-index: 2;\n    }\n\n    .dms-paper {\n      position: absolute;\n      left: 20%;\n      bottom: 10%;\n      display: flex;\n      flex-direction: column;\n      gap: 8px;\n      width: 60%;\n      height: 98%;\n      padding: 15px;\n      border: 1px solid #e5e8ec;\n      border-radius: 8px;\n      background: #fff;\n      color: #263347;\n      text-align: left;\n      font: inherit;\n      cursor: pointer;\n      box-shadow: 0 6px 18px rgba(22, 40, 70, 0.12);\n      transition:\n        transform 650ms cubic-bezier(0.22, 1.3, 0.36, 1),\n        box-shadow 250ms ease;\n    }\n\n    .dms-paper:nth-child(1) {\n      transform: translate(-12%, -3%) rotate(-6deg);\n    }\n\n    .dms-paper:nth-child(2) {\n      transform: translate(12%, -6%) rotate(5deg);\n    }\n\n    .dms-paper:nth-child(3) {\n      transform: translateY(-9%);\n    }\n\n    .dms-paper-number {\n      font-size: 10px;\n      color: #8694a7;\n    }\n\n    .dms-paper strong {\n      font-size: 11px;\n      font-weight: 600;\n      line-height: 1.35;\n    }\n\n    .dms-paper-block {\n      display: block;\n      min-height: 30px;\n      border-radius: 4px;\n      background: linear-gradient(135deg, #edf4ff, #d8e8ff);\n    }\n\n    .dms-paper-line {\n      display: block;\n      height: 4px;\n      flex-shrink: 0;\n      border-radius: 4px;\n      background: #e6ebf1;\n    }\n\n    .dms-paper-line.short {\n      width: 65%;\n    }\n\n    .dms-paper-stamp {\n      margin-top: auto;\n      color: #3977c8;\n      font-size: 10px;\n      letter-spacing: 1px;\n    }\n\n    .dms-folder-front {\n      position: absolute;\n      inset: 16% 0 0;\n      z-index: 3;\n      display: flex;\n      flex-direction: column;\n      justify-content: flex-end;\n      align-items: flex-start;\n      padding: 24px;\n      border: 0;\n      border-radius: 12px;\n      color: #fff;\n      text-align: left;\n      font: inherit;\n      cursor: pointer;\n      background: linear-gradient(\n        155deg,\n        #65a6ff,\n        #3d8bff 48%,\n        #2368cf\n      );\n      box-shadow:\n        inset 0 1px 0 rgba(255, 255, 255, 0.4),\n        0 12px 24px -14px rgba(31, 79, 150, 0.4);\n      transform-origin: center bottom;\n      transition: transform 650ms cubic-bezier(0.22, 1.2, 0.36, 1);\n    }\n\n    .dms-folder-brand {\n      font-size: 30px;\n      font-weight: 600;\n      letter-spacing: -1.2px;\n    }\n\n    .dms-folder-caption {\n      margin-top: 5px;\n      font-size: 10px;\n      opacity: 0.85;\n    }\n\n    .dms-folder-toggle {\n      position: absolute;\n      top: 16px;\n      right: 20px;\n      font-size: 24px;\n    }\n\n    .dms-folder.is-open .dms-folder-front {\n      transform: rotateX(-52deg);\n    }\n\n    .dms-folder.is-open .dms-paper:nth-child(1) {\n      transform: translate(-55%, -49%) rotate(-17deg);\n    }\n\n    .dms-folder.is-open .dms-paper:nth-child(2) {\n      transform: translate(55%, -49%) rotate(17deg);\n    }\n\n    .dms-folder.is-open .dms-paper:nth-child(3) {\n      transform: translateY(-66%);\n    }\n\n    .dms-folder.is-open .dms-paper:hover,\n    .dms-folder.is-open .dms-paper:focus-visible {\n      z-index: 5;\n      box-shadow: 0 12px 24px rgba(22, 40, 70, 0.22);\n    }\n\n    .dms-folder-front:focus-visible,\n    .dms-paper:focus-visible {\n      outline: 2px solid #153d75;\n      outline-offset: 4px;\n    }\n\n    .dms-folder-hint {\n      margin: 26px 0 0;\n      font-size: 12px;\n      line-height: 18px;\n      color: #58675d;\n      text-align: center;\n    }\n\n    /* DOCUMENT PREVIEW MODAL */\n    .dms-preview {\n      width: min(380px, calc(100% - 32px));\n      max-height: calc(100dvh - 48px);\n      padding: 40px 28px;\n      overflow: auto;\n      border: 0;\n      border-radius: 16px;\n      background: #fff;\n      color: #111;\n      font-family: Inter, \"Inter Placeholder\", sans-serif;\n      box-shadow: 0 24px 80px rgba(0, 0, 0, 0.2);\n    }\n\n    .dms-preview::backdrop {\n      background: rgba(16, 27, 40, 0.4);\n    }\n\n    .dms-preview-close {\n      position: absolute;\n      top: 8px;\n      right: 8px;\n      width: 40px;\n      height: 40px;\n      border: 0;\n      border-radius: 50%;\n      background: #f3f5f7;\n      color: #111;\n      font-size: 24px;\n      cursor: pointer;\n    }\n\n    .dms-preview-label {\n      margin: 0 0 14px;\n      font-size: 10px;\n      letter-spacing: 1.4px;\n      color: #3977c8;\n    }\n\n    .dms-preview h3 {\n      margin: 0 0 12px;\n      font-size: 24px;\n      font-weight: 500;\n      letter-spacing: -0.7px;\n    }\n\n    .dms-preview-description {\n      font-size: 14px;\n      line-height: 1.6;\n      color: #666;\n    }\n\n    .dms-preview-lines {\n      display: grid;\n      gap: 12px;\n      margin-top: 32px;\n    }\n\n    .dms-preview-lines span {\n      height: 7px;\n      border-radius: 4px;\n      background: #edf0f4;\n    }\n\n    .dms-preview-lines span:last-child {\n      width: 65%;\n    }\n\n    @media (hover: hover) {\n      .dms-link:hover svg {\n        transform: translateX(3px);\n      }\n\n      .dms-link:hover span {\n        text-decoration-color: currentColor;\n      }\n    }\n\n    @media (max-width: 1000px) {\n      .dms-grid {\n        gap: 24px;\n      }\n\n      .dms-card-content {\n        padding: 30px 28px 16px;\n      }\n    }\n\n    @media (max-width: 700px) {\n      .dms-section {\n        padding: 24px 16px;\n      }\n\n      .dms-grid {\n        grid-template-columns: 1fr;\n        gap: 20px;\n      }\n\n      .dms-card {\n        min-height: 540px;\n      }\n\n      .dms-card-content {\n        padding: 28px 24px 16px;\n      }\n\n      .dms-heading {\n        font-size: 27px;\n        line-height: 1.25;\n        letter-spacing: -0.9px;\n      }\n\n      .dms-drift {\n        --tile-width: 130px;\n        --tile-height: 92px;\n        --tile-gap: 12px;\n        min-height: 290px;\n      }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      .dms-link svg,\n      .dms-paper,\n      .dms-folder-front {\n        transition: none;\n      }\n\n      .dms-drift-track {\n        will-change: auto;\n      }\n    }\n</style>\n  <!-- DMS DUAL INTERACTIVE FEATURE SHOWCASE SECTION -->\n  <section class=\"dms-section\" id=\"showcase\" aria-label=\"Explore DMS services\">\n    <div class=\"dms-grid\">\n\n      <!-- LEFT CARD: 3D DRIFT WALL -->\n      <article class=\"dms-card\">\n        <div class=\"dms-card-content\">\n          <h2 class=\"dms-heading\">\n            Bahrain Visa &amp; Residence Permit Services\n          </h2>\n\n          <p class=\"dms-tagline\">\n            Expert Bahrain Ministry services for hassle-free\n            approvals and assistance.\n          </p>\n\n          <a class=\"dms-link\" href=\"services.html#business-setup\">\n            <span>Explore Bahrain visa services</span>\n            <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n              <path d=\"m9 5 7 7-7 7\"/>\n            </svg>\n          </a>\n        </div>\n\n        <div class=\"dms-drift\" data-drift>\n          <div class=\"dms-drift-scene\" aria-hidden=\"true\">\n            <div class=\"dms-drift-plane\"></div>\n          </div>\n        </div>\n      </article>\n\n      <!-- RIGHT CARD: 3D INTERACTIVE FOLDER -->\n      <article class=\"dms-card\">\n        <div class=\"dms-card-content\">\n          <p class=\"dms-label\">VISA &amp; RESIDENCY</p>\n\n          <h2 class=\"dms-heading\">\n            Your next chapter in Bahrain\n            starts with the right support\n          </h2>\n\n          <a class=\"dms-link\" href=\"services.html#residency\">\n            <span>Company formation services</span>\n            <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n              <path d=\"m9 5 7 7-7 7\"/>\n            </svg>\n          </a>\n        </div>\n\n        <div class=\"dms-folder-area\">\n          <div class=\"dms-folder\" data-folder>\n            <div class=\"dms-folder-back\" aria-hidden=\"true\">\n              <span>Documents</span>\n            </div>\n\n            <div class=\"dms-folder-papers\" id=\"dms-papers\" inert>\n              <button\n                class=\"dms-paper\"\n                type=\"button\"\n                data-title=\"Visa application\"\n                data-description=\"Keep your visa application documents together.\"\n                aria-label=\"Preview visa application\"\n              >\n                <span class=\"dms-paper-number\">01</span>\n                <strong>Visa application</strong>\n                <span class=\"dms-paper-block\"></span>\n                <span class=\"dms-paper-line\"></span>\n                <span class=\"dms-paper-line short\"></span>\n                <span class=\"dms-paper-stamp\">DMS</span>\n              </button>\n\n              <button\n                class=\"dms-paper\"\n                type=\"button\"\n                data-title=\"Residence permit\"\n                data-description=\"Organise your residence permit documents.\"\n                aria-label=\"Preview residence permit\"\n              >\n                <span class=\"dms-paper-number\">02</span>\n                <strong>Residence permit</strong>\n                <span class=\"dms-paper-block\"></span>\n                <span class=\"dms-paper-line\"></span>\n                <span class=\"dms-paper-line short\"></span>\n                <span class=\"dms-paper-stamp\">DMS</span>\n              </button>\n\n              <button\n                class=\"dms-paper\"\n                type=\"button\"\n                data-title=\"Supporting documents\"\n                data-description=\"Keep supporting documents ready for your application.\"\n                aria-label=\"Preview supporting documents\"\n              >\n                <span class=\"dms-paper-number\">03</span>\n                <strong>Supporting documents</strong>\n                <span class=\"dms-paper-block\"></span>\n                <span class=\"dms-paper-line\"></span>\n                <span class=\"dms-paper-line short\"></span>\n                <span class=\"dms-paper-stamp\">DMS</span>\n              </button>\n            </div>\n\n            <button\n              class=\"dms-folder-front\"\n              type=\"button\"\n              aria-expanded=\"false\"\n              aria-controls=\"dms-papers\"\n              aria-label=\"Open documents folder\"\n            >\n              <span class=\"dms-folder-brand\">DMS</span>\n              <span class=\"dms-folder-caption\">\n                Your documents, together.\n              </span>\n              <span class=\"dms-folder-toggle\" aria-hidden=\"true\">+</span>\n            </button>\n          </div>\n\n          <p class=\"dms-folder-hint\">Click the folder to explore</p>\n        </div>\n      </article>\n\n    </div>\n  </section>\n\n  <!-- Illustrative document preview modal -->\n  <dialog class=\"dms-preview\" aria-labelledby=\"dms-preview-title\">\n    <button\n      class=\"dms-preview-close\"\n      type=\"button\"\n      aria-label=\"Close document preview\"\n    >×</button>\n\n    <p class=\"dms-preview-label\">DOCUMENT PREVIEW</p>\n    <h3 id=\"dms-preview-title\"></h3>\n    <p class=\"dms-preview-description\"></p>\n\n    <div class=\"dms-preview-lines\" aria-hidden=\"true\">\n      <span></span>\n      <span></span>\n      <span></span>\n      <span></span>\n    </div>\n  </dialog>\n<script>\n    // ==========================================\n    // DMS DUAL INTERACTIVE FEATURE SHOWCASE SCRIPT\n    // ==========================================\n    (() => {\n      const reducedMotion = window.matchMedia(\n        \"(prefers-reduced-motion: reduce)\"\n      );\n\n      /* LEFT: AUTOMATIC DRIFT WALL */\n      document.querySelectorAll(\"[data-drift]\").forEach((wall) => {\n        const images = [\n          \"assets/ministry.svg\",\n          \"assets/attestation.svg\",\n          \"assets/saudi-visa.svg\",\n          \"assets/residency.svg\",\n          \"assets/global-visa.svg\"\n        ];\n\n        const plane = wall.querySelector(\".dms-drift-plane\");\n        if (!plane) return;\n\n        let tracks = [];\n        let frameId = 0;\n        let lastTime = null;\n        let inView = true;\n        let pointer = { x: 0, y: 0 };\n        let damped = { x: 0, y: 0 };\n\n        function setPlane(x = 0, y = 0) {\n          plane.style.transform =\n            \"translate(-50%, -50%) scale(1.18) \" +\n            `rotateX(${16 + y}deg) ` +\n            `rotateY(${-14 + x}deg) translateZ(-120px)`;\n        }\n\n        function stop() {\n          cancelAnimationFrame(frameId);\n          frameId = 0;\n          lastTime = null;\n        }\n\n        function canAnimate() {\n          return !reducedMotion.matches && inView && !document.hidden;\n        }\n\n        function tick(time) {\n          frameId = 0;\n          if (!canAnimate()) return;\n\n          const dt = lastTime === null\n            ? 0\n            : Math.min((time - lastTime) / 1000, 0.05);\n\n          lastTime = time;\n\n          const smoothing = 1 - Math.exp(-dt / 0.12);\n\n          damped.x += (pointer.x * 4.8 - damped.x) * smoothing;\n          damped.y += (-pointer.y * 4.8 - damped.y) * smoothing;\n\n          setPlane(damped.x, damped.y);\n\n          tracks.forEach((track) => {\n            track.offset =\n              ((track.offset + track.velocity * dt) % track.period +\n                track.period) % track.period;\n\n            track.element.style.transform =\n              `translate3d(0, ${-track.offset}px, 0)`;\n          });\n\n          frameId = requestAnimationFrame(tick);\n        }\n\n        function syncPlayback() {\n          stop();\n\n          if (reducedMotion.matches) {\n            pointer = { x: 0, y: 0 };\n            damped = { x: 0, y: 0 };\n            setPlane();\n          }\n\n          if (canAnimate() && tracks.length) {\n            frameId = requestAnimationFrame(tick);\n          }\n        }\n\n        function build() {\n          stop();\n          plane.replaceChildren();\n          tracks = [];\n\n          if (!images.length) return;\n\n          const styles = getComputedStyle(wall);\n\n          const tileHeight = parseFloat(\n            styles.getPropertyValue(\"--tile-height\")\n          ) || 105;\n\n          const gap = parseFloat(\n            styles.getPropertyValue(\"--tile-gap\")\n          ) || 16;\n\n          const unit = tileHeight + gap;\n\n          for (let columnIndex = 0; columnIndex < 5; columnIndex++) {\n            const column = document.createElement(\"div\");\n            column.className = \"dms-drift-column\";\n\n            const track = document.createElement(\"div\");\n            track.className = \"dms-drift-track\";\n\n            const period = images.length * unit;\n            const copies = Math.max(\n              3,\n              Math.ceil((wall.clientHeight || 320) * 2 / period) + 2\n            );\n\n            for (let copy = 0; copy < copies; copy++) {\n              images.forEach((_, imageIndex) => {\n                const tile = document.createElement(\"div\");\n                tile.className = \"dms-drift-tile\";\n\n                const image = document.createElement(\"img\");\n                image.src = images[\n                  (imageIndex + columnIndex) % images.length\n                ];\n\n                image.alt = \"\";\n                image.decoding = \"async\";\n                image.draggable = false;\n\n                image.addEventListener(\"error\", () => {\n                  image.remove();\n                }, { once: true });\n\n                tile.append(image);\n                track.append(tile);\n              });\n            }\n\n            column.append(track);\n            plane.append(column);\n\n            const pseudo =\n              ((columnIndex * 0.6180339887 + 0.35) % 1) * 2 - 1;\n\n            const velocity =\n              42 * (1 + 0.45 * pseudo) *\n              (columnIndex % 2 === 0 ? 1 : -1);\n\n            const offset = period * ((columnIndex * 0.37) % 1);\n\n            track.style.transform =\n              `translate3d(0, ${-offset}px, 0)`;\n\n            tracks.push({\n              element: track,\n              velocity,\n              offset,\n              period\n            });\n          }\n\n          syncPlayback();\n        }\n\n        wall.addEventListener(\"pointermove\", (event) => {\n          if (\n            event.pointerType !== \"mouse\" ||\n            reducedMotion.matches\n          ) return;\n\n          const rect = wall.getBoundingClientRect();\n\n          pointer = {\n            x: (event.clientX - rect.left) / rect.width - 0.5,\n            y: (event.clientY - rect.top) / rect.height - 0.5\n          };\n        });\n\n        wall.addEventListener(\"pointerleave\", () => {\n          pointer = { x: 0, y: 0 };\n        });\n\n        if (\"IntersectionObserver\" in window) {\n          const observer = new IntersectionObserver(([entry]) => {\n            inView = entry.isIntersecting;\n            syncPlayback();\n          });\n\n          observer.observe(wall);\n        }\n\n        if (\"ResizeObserver\" in window) {\n          let previousSize = \"\";\n\n          const resizeObserver = new ResizeObserver(([entry]) => {\n            const size =\n              `${entry.contentRect.width}:${entry.contentRect.height}`;\n\n            if (size === previousSize) return;\n\n            previousSize = size;\n            build();\n          });\n\n          resizeObserver.observe(wall);\n        } else {\n          window.addEventListener(\"resize\", build);\n        }\n\n        reducedMotion.addEventListener(\"change\", syncPlayback);\n        document.addEventListener(\"visibilitychange\", syncPlayback);\n\n        build();\n      });\n\n      /* RIGHT: FOLDER + AUTOMATIC SCROLL OPEN */\n      const folder = document.querySelector(\"[data-folder]\");\n      const dialog = document.querySelector(\".dms-preview\");\n      if (!folder || !dialog) return;\n\n      const toggle = folder.querySelector(\".dms-folder-front\");\n      const papers = folder.querySelector(\".dms-folder-papers\");\n      const paperButtons = [...papers.querySelectorAll(\".dms-paper\")];\n      const hint = document.querySelector(\".dms-folder-hint\");\n      const closeButton = dialog.querySelector(\".dms-preview-close\");\n\n      let open = false;\n      let lastPaper = null;\n      let folderInView = false;\n\n      function setOpen(value) {\n        open = value;\n\n        folder.classList.toggle(\"is-open\", open);\n        papers.inert = !open;\n\n        paperButtons.forEach((paper) => {\n          paper.tabIndex = open ? 0 : -1;\n        });\n\n        toggle.setAttribute(\"aria-expanded\", String(open));\n        toggle.setAttribute(\n          \"aria-label\",\n          open ? \"Close documents folder\" : \"Open documents folder\"\n        );\n\n        const toggleIcon = toggle.querySelector(\".dms-folder-toggle\");\n        if (toggleIcon) toggleIcon.textContent = open ? \"−\" : \"+\";\n\n        if (hint) {\n          hint.textContent = open\n            ? \"Select a document to preview\"\n            : \"Click the folder to explore\";\n        }\n      }\n\n      toggle.addEventListener(\"click\", () => {\n        setOpen(!open);\n      });\n\n      paperButtons.forEach((paper) => {\n        paper.addEventListener(\"click\", () => {\n          if (!open) return;\n\n          lastPaper = paper;\n\n          dialog.querySelector(\"#dms-preview-title\").textContent =\n            paper.dataset.title;\n\n          dialog.querySelector(\".dms-preview-description\").textContent =\n            paper.dataset.description;\n\n          dialog.showModal();\n        });\n      });\n\n      if (closeButton) {\n        closeButton.addEventListener(\"click\", () => {\n          dialog.close();\n        });\n      }\n\n      dialog.addEventListener(\"click\", (event) => {\n        if (event.target !== dialog) return;\n\n        const rect = dialog.getBoundingClientRect();\n\n        if (\n          event.clientX < rect.left ||\n          event.clientX > rect.right ||\n          event.clientY < rect.top ||\n          event.clientY > rect.bottom\n        ) {\n          dialog.close();\n        }\n      });\n\n      dialog.addEventListener(\"close\", () => {\n        if (lastPaper) {\n          setOpen(true);\n          lastPaper.focus({ preventScroll: true });\n        }\n      });\n\n      folder.addEventListener(\"keydown\", (event) => {\n        if (event.key === \"Escape\" && !dialog.open) {\n          toggle.focus({ preventScroll: true });\n          setOpen(false);\n        }\n      });\n\n      folder.addEventListener(\"focusout\", () => {\n        requestAnimationFrame(() => {\n          if (\n            !folderInView &&\n            !dialog.open &&\n            !folder.contains(document.activeElement)\n          ) {\n            setOpen(false);\n          }\n        });\n      });\n\n      setOpen(false);\n\n      if (\"IntersectionObserver\" in window) {\n        const folderObserver = new IntersectionObserver(([entry]) => {\n          folderInView = entry.isIntersecting;\n\n          if (folderInView) {\n            setOpen(true);\n          } else if (\n            !dialog.open &&\n            !folder.contains(document.activeElement)\n          ) {\n            setOpen(false);\n          }\n        }, {\n          threshold: 0,\n          rootMargin: \"0px 0px -15% 0px\"\n        });\n\n        folderObserver.observe(folder);\n      }\n    })();\n</script>"
