{
  "version": "0.4",
  "title": "DMS - Modern Branded Footer",
  "type": "section",
  "content": [
    {
      "id": "sec_yu239cl",
      "elType": "section",
      "isInner": false,
      "settings": {
        "layout": "full_width",
        "gap": "no",
        "structure": "10"
      },
      "elements": [
        {
          "id": "col_hmsy3sy",
          "elType": "column",
          "isInner": false,
          "settings": {
            "_column_size": 100
          },
          "elements": [
            {
              "id": "wid_3yw2sad",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<style>\n    /* ==========================================================================\n       DMS MODERN BRANDED FOOTER SECTION\n       ========================================================================== */\n    .dms-footer,\n    .dms-footer * {\n      box-sizing: border-box;\n    }\n\n    .dms-footer {\n      --df-green: #28543c;\n      --df-text: #171717;\n      --df-muted: #858585;\n      --df-line: #ecece8;\n\n      width: 100%;\n      background: #fff;\n      color: var(--df-text);\n\n      font-family: Inter, \"Inter Placeholder\", sans-serif;\n      font-size: 14px;\n      font-weight: 400;\n      line-height: 21px;\n      letter-spacing: -0.3px;\n    }\n\n    .dms-footer .df-inner {\n      width: 100%;\n      max-width: 1368px;\n      margin: 0 auto;\n      padding: 58px 24px 28px;\n    }\n\n    /* Main five-column layout */\n    .dms-footer .df-grid {\n      display: grid;\n      grid-template-columns: repeat(5, minmax(0, 1fr));\n      gap: 38px;\n    }\n\n    .dms-footer .df-column {\n      min-width: 0;\n    }\n\n    .dms-footer .df-group + .df-group {\n      margin-top: 30px;\n    }\n\n    .dms-footer .df-title {\n      margin: 0 0 17px;\n      color: #737770;\n      font-family: inherit;\n      font-size: 10px;\n      font-weight: 500;\n      line-height: 16px;\n      letter-spacing: 1.15px;\n      text-transform: uppercase;\n    }\n\n    .dms-footer .df-list {\n      display: grid;\n      gap: 6px;\n      margin: 0;\n      padding: 0;\n      list-style: none;\n    }\n\n    .dms-footer .df-list li {\n      margin: 0;\n      padding: 0;\n    }\n\n    .dms-footer a {\n      color: var(--df-text);\n      font-family: inherit;\n      text-decoration: none;\n      transition: color 180ms ease;\n    }\n\n    .dms-footer .df-list a {\n      display: inline-block;\n      padding: 2px 0;\n      font-size: 13px;\n      font-weight: 400;\n      line-height: 20px;\n      letter-spacing: -0.25px;\n      overflow-wrap: anywhere;\n    }\n\n    .dms-footer a:hover {\n      color: var(--df-green);\n      text-decoration: underline;\n      text-underline-offset: 4px;\n    }\n\n    .dms-footer a:focus-visible,\n    .dms-footer button:focus-visible {\n      outline: 2px solid var(--df-green);\n      outline-offset: 5px;\n      border-radius: 3px;\n    }\n\n    /* Brand and location row */\n    .dms-footer .df-middle {\n      display: flex;\n      align-items: flex-start;\n      justify-content: space-between;\n      gap: 36px;\n      margin-top: 55px;\n    }\n\n    .dms-footer .df-brand {\n      max-width: 340px;\n    }\n\n    .dms-footer .df-wordmark {\n      display: inline-block;\n      color: var(--df-green);\n      font-size: 29px;\n      font-weight: 600;\n      line-height: 34px;\n      letter-spacing: -1.5px;\n    }\n\n    .dms-footer .df-wordmark:hover {\n      text-decoration: none;\n    }\n\n    .dms-footer .df-brand p {\n      margin: 10px 0 0;\n      color: var(--df-muted);\n      font-size: 12px;\n      line-height: 20px;\n      letter-spacing: -0.1px;\n    }\n\n    .dms-footer .df-location {\n      width: 240px;\n      max-width: 100%;\n    }\n\n    .dms-footer .df-location .df-title {\n      margin-bottom: 12px;\n    }\n\n    .dms-footer .df-location-value {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      min-height: 38px;\n      padding: 8px 12px;\n      border: 1px solid #e0e2dc;\n      border-radius: 8px;\n      color: #535b50;\n      font-size: 13px;\n      line-height: 20px;\n    }\n\n    .dms-footer .df-location-value svg {\n      flex: 0 0 17px;\n      width: 17px;\n      height: 17px;\n      fill: none;\n      stroke: #899181;\n      stroke-width: 1.4;\n      stroke-linecap: round;\n      stroke-linejoin: round;\n    }\n\n    /* Legal and back-to-top row */\n    .dms-footer .df-bottom {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      flex-wrap: wrap;\n      gap: 15px 24px;\n      margin-top: 38px;\n      padding-top: 22px;\n      border-top: 1px solid var(--df-line);\n    }\n\n    .dms-footer .df-legal {\n      display: flex;\n      align-items: center;\n      flex-wrap: wrap;\n      gap: 10px 20px;\n    }\n\n    .dms-footer .df-copyright,\n    .dms-footer .df-legal a {\n      margin: 0;\n      color: #898989;\n      font-size: 11px;\n      font-weight: 400;\n      line-height: 18px;\n      letter-spacing: -0.1px;\n    }\n\n    .dms-footer .df-legal a:hover {\n      color: var(--df-green);\n    }\n\n    .dms-footer .df-top {\n      appearance: none;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: 8px;\n      min-height: 44px;\n      padding: 8px 0;\n\n      border: 0;\n      background: transparent;\n      box-shadow: none;\n      color: #737b6e;\n\n      font-family: inherit;\n      font-size: 11px;\n      font-weight: 400;\n      line-height: 18px;\n      letter-spacing: -0.1px;\n      cursor: pointer;\n    }\n\n    .dms-footer .df-top svg {\n      width: 15px;\n      height: 15px;\n      fill: none;\n      stroke: currentColor;\n      stroke-width: 1.5;\n      stroke-linecap: round;\n      stroke-linejoin: round;\n      transition: transform 200ms ease;\n    }\n\n    .dms-footer .df-top:hover {\n      background: transparent;\n      color: var(--df-green);\n    }\n\n    .dms-footer .df-top:hover svg {\n      transform: translateY(-3px);\n    }\n\n    .dms-footer .df-note {\n      max-width: 1080px;\n      margin: 26px 0 0;\n      color: #92968f;\n      font-size: 11px;\n      font-weight: 400;\n      line-height: 18px;\n      letter-spacing: -0.1px;\n    }\n\n    /* Tablet */\n    @media (max-width: 1024px) {\n      .dms-footer .df-grid {\n        grid-template-columns: repeat(3, minmax(0, 1fr));\n        gap: 34px;\n      }\n\n      .dms-footer .df-middle {\n        margin-top: 40px;\n      }\n    }\n\n    /* Mobile */\n    @media (max-width: 600px) {\n      .dms-footer .df-inner {\n        padding: 34px 20px 24px;\n      }\n\n      .dms-footer .df-grid {\n        grid-template-columns: repeat(2, minmax(0, 1fr));\n        gap: 28px 24px;\n      }\n\n      .dms-footer .df-title {\n        margin-bottom: 12px;\n        font-size: 9px;\n        letter-spacing: 1px;\n      }\n\n      .dms-footer .df-list {\n        gap: 4px;\n      }\n\n      .dms-footer .df-list a {\n        padding: 6px 0;\n        font-size: 12px;\n        line-height: 19px;\n      }\n\n      .dms-footer .df-group + .df-group {\n        margin-top: 24px;\n      }\n\n      .dms-footer .df-middle {\n        flex-direction: column;\n        gap: 26px;\n        margin-top: 34px;\n      }\n\n      .dms-footer .df-brand {\n        max-width: 100%;\n      }\n\n      .dms-footer .df-location {\n        width: 100%;\n      }\n\n      .dms-footer .df-bottom {\n        align-items: flex-start;\n        margin-top: 28px;\n        padding-top: 18px;\n      }\n\n      .dms-footer .df-legal {\n        gap: 10px 16px;\n      }\n\n      .dms-footer .df-copyright {\n        flex-basis: 100%;\n      }\n\n      .dms-footer .df-legal a {\n        padding: 5px 0;\n      }\n\n      .dms-footer .df-note {\n        margin-top: 18px;\n      }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      .dms-footer *,\n      .dms-footer *::before,\n      .dms-footer *::after {\n        transition: none !important;\n      }\n    }\n</style>\n\n  <!-- DMS MODERN BRANDED FOOTER -->\n  <footer class=\"dms-footer\" aria-label=\"DMS footer\">\n    <div class=\"df-inner\">\n\n      <nav class=\"df-grid\" aria-label=\"Footer navigation\">\n\n        <div class=\"df-column\">\n          <div class=\"df-group\">\n            <h2 class=\"df-title\">Our services</h2>\n\n            <ul class=\"df-list\">\n              <li>\n                <a href=\"#services\">\n                  Government Relations\n                </a>\n              </li>\n              <li>\n                <a href=\"#services\">\n                  Bahrain Ministry Services\n                </a>\n              </li>\n              <li>\n                <a href=\"#services\">\n                  Document Attestation\n                </a>\n              </li>\n              <li>\n                <a href=\"#services\">\n                  Corporate Setup\n                </a>\n              </li>\n              <li>\n                <a href=\"#services\">\n                  Documentation Assistance\n                </a>\n              </li>\n            </ul>\n          </div>\n        </div>\n\n        <div class=\"df-column\">\n          <div class=\"df-group\">\n            <h2 class=\"df-title\">Visa & residency</h2>\n\n            <ul class=\"df-list\">\n              <li>\n                <a href=\"#services\">\n                  Bahrain Visa Services\n                </a>\n              </li>\n              <li>\n                <a href=\"#services\">\n                  Residence Permit Services\n                </a>\n              </li>\n              <li>\n                <a href=\"#services\">\n                  Bahrain Golden Visa\n                </a>\n              </li>\n              <li>\n                <a href=\"#services\">\n                  Self-Sponsorship Visa\n                </a>\n              </li>\n              <li>\n                <a href=\"#services\">\n                  Saudi Visa Services\n                </a>\n              </li>\n              <li>\n                <a href=\"#services\">\n                  Global Visa Services\n                </a>\n              </li>\n            </ul>\n          </div>\n        </div>\n\n        <div class=\"df-column\">\n          <div class=\"df-group\">\n            <h2 class=\"df-title\">Business support</h2>\n\n            <ul class=\"df-list\">\n              <li>\n                <a href=\"#services\">\n                  Starting a Business\n                </a>\n              </li>\n              <li>\n                <a href=\"#services\">\n                  Government Process Support\n                </a>\n              </li>\n              <li>\n                <a href=\"#services\">\n                  Business Documentation\n                </a>\n              </li>\n              <li>\n                <a href=\"#contact\">\n                  Discuss Your Requirements\n                </a>\n              </li>\n            </ul>\n          </div>\n        </div>\n\n        <div class=\"df-column\">\n          <div class=\"df-group\">\n            <h2 class=\"df-title\">Company</h2>\n\n            <ul class=\"df-list\">\n              <li><a href=\"#hero-section\">Home</a></li>\n              <li><a href=\"#story\">About DMS</a></li>\n              <li><a href=\"#services\">Our Services</a></li>\n              <li><a href=\"#blog\">Blog</a></li>\n              <li><a href=\"#contact\">Contact Us</a></li>\n            </ul>\n          </div>\n        </div>\n\n        <div class=\"df-column\">\n          <div class=\"df-group\">\n            <h2 class=\"df-title\">Support</h2>\n\n            <ul class=\"df-list\">\n              <li><a href=\"#contact\">Talk to Our Team</a></li>\n              <li><a href=\"#contact\">Service Enquiries</a></li>\n              <li><a href=\"#contact\">Application Assistance</a></li>\n              <li><a href=\"#contact\">Request a Consultation</a></li>\n            </ul>\n          </div>\n\n          <div class=\"df-group\">\n            <h2 class=\"df-title\">Resources</h2>\n\n            <ul class=\"df-list\">\n              <li><a href=\"#blog\">Articles & Updates</a></li>\n              <li><a href=\"#services\">Explore Our Services</a></li>\n            </ul>\n          </div>\n        </div>\n\n      </nav>\n\n      <div class=\"df-middle\">\n\n        <div class=\"df-brand\">\n          <a class=\"df-wordmark\" href=\"#hero-section\" aria-label=\"DMS home\">\n            DMS<span aria-hidden=\"true\">.</span>\n          </a>\n\n          <p>\n            Strategic visas, corporate setup,<br>\n            and residency solutions in Bahrain.\n          </p>\n        </div>\n\n        <div class=\"df-location\">\n          <h2 class=\"df-title\">Based in Bahrain</h2>\n\n          <div class=\"df-location-value\">\n            <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n              <path d=\"M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z\"/>\n              <circle cx=\"12\" cy=\"10\" r=\"2.5\"/>\n            </svg>\n\n            <span>Kingdom of Bahrain</span>\n          </div>\n        </div>\n\n      </div>\n\n      <div class=\"df-bottom\">\n        <div class=\"df-legal\">\n          <p class=\"df-copyright\">\n            © <span class=\"df-year\">2026</span> DMS Bahrain.\n            All rights reserved.\n          </p>\n\n          <a href=\"#privacy\">Privacy Policy</a>\n          <a href=\"#terms\">Terms & Conditions</a>\n        </div>\n\n        <button class=\"df-top\" type=\"button\">\n          Back to top\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M12 19V5m-6 6 6-6 6 6\"/>\n          </svg>\n        </button>\n      </div>\n\n      <p class=\"df-note\">\n        DMS supports individuals, families and businesses with government\n        relations, visa services, residency solutions and documentation\n        assistance in Bahrain.\n      </p>\n\n    </div>\n  </footer>\n\n<script>\n    /* DMS MODERN BRANDED FOOTER INTERACTIVITY */\n    (() => {\n      const footer = document.querySelector(\".dms-footer\");\n      if (!footer) return;\n      if (footer.dataset.initialized === \"true\") return;\n\n      footer.dataset.initialized = \"true\";\n\n      const year = footer.querySelector(\".df-year\");\n      const topButton = footer.querySelector(\".df-top\");\n      const reducedMotion = window.matchMedia(\n        \"(prefers-reduced-motion: reduce)\"\n      );\n\n      if (year) year.textContent = new Date().getFullYear();\n\n      if (topButton) {\n        topButton.hidden = false;\n        topButton.addEventListener(\"click\", () => {\n          window.scrollTo({\n            top: 0,\n            behavior: reducedMotion.matches ? \"instant\" : \"smooth\"\n          });\n        });\n      }\n    })();\n</script>"
              }
            }
          ]
        }
      ]
    }
  ]
}