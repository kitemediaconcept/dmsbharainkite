            {
              "id": "wid_xsbmxjm",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<style>\n    /* ==========================================================================\n       DMS BAHRAIN GOLDEN VISA SECTION\n       ========================================================================== */\n    .dms-golden-section,\n    .dms-golden-section * {\n      box-sizing: border-box;\n    }\n\n    .dms-golden-section {\n      width: 100%;\n      max-width: 1368px;\n      margin: 0 auto;\n      padding: 20px 24px 40px;\n      font-family: Inter, \"Inter Placeholder\", sans-serif;\n      color: #111;\n    }\n\n    .dms-golden-panel {\n      position: relative;\n      overflow: hidden;\n      isolation: isolate;\n      padding: 44px 24px 36px;\n      border: 1px solid #eee9df;\n      border-radius: 18px;\n      background: #f8f7f4;\n      text-align: center;\n    }\n\n    .dms-golden-panel::before {\n      content: \"\";\n      position: absolute;\n      inset: 10% 0;\n      z-index: -1;\n      pointer-events: none;\n      background: radial-gradient(\n        ellipse at center,\n        rgba(218, 188, 116, 0.16),\n        transparent 65%\n      );\n    }\n\n    .dms-golden-eyebrow {\n      margin: 0 0 10px;\n      font-size: 11px;\n      font-weight: 600;\n      line-height: 16px;\n      letter-spacing: 2px;\n      text-transform: uppercase;\n      color: #80735a;\n    }\n\n    .dms-golden-heading {\n      max-width: 680px;\n      margin: 0 auto;\n      font-size: clamp(26px, 2.8vw, 36px);\n      font-weight: 400;\n      line-height: 1.15;\n      letter-spacing: -1.2px;\n      text-wrap: balance;\n    }\n\n    .dms-golden-description {\n      max-width: 490px;\n      margin: 12px auto 0;\n      font-size: 16px;\n      font-weight: 400;\n      line-height: 22px;\n      letter-spacing: -0.48px;\n      color: #706d66;\n      text-wrap: balance;\n    }\n\n    /* Compact metallic artwork */\n    .dms-metal-stage {\n      --rotate-x: 0deg;\n      --rotate-y: 0deg;\n\n      position: relative;\n      display: grid;\n      place-items: center;\n      min-height: 0;\n      margin: 24px auto;\n      perspective: 1000px;\n    }\n\n    .dms-metal-art {\n      position: relative;\n      width: 100%;\n      max-width: 820px;\n      padding: 0;\n      transform:\n        rotateX(var(--rotate-x))\n        rotateY(var(--rotate-y));\n      transition: transform 500ms ease-out;\n      transform-style: preserve-3d;\n    }\n\n    .dms-metal-ornament {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 18px;\n      margin-bottom: 10px;\n      color: #ad8843;\n    }\n\n    .dms-metal-ornament::before,\n    .dms-metal-ornament::after {\n      content: \"\";\n      width: 65px;\n      height: 1px;\n      background: linear-gradient(\n        90deg,\n        transparent,\n        #c4a66b,\n        transparent\n      );\n    }\n\n    .dms-metal-ornament svg {\n      width: 18px;\n      height: 18px;\n      fill: none;\n      stroke: currentColor;\n      stroke-width: 1.2;\n    }\n\n    .dms-metal-text {\n      display: block;\n      margin: 0;\n      font-size: clamp(42px, 6vw, 76px);\n      font-weight: 600;\n      line-height: 1.05;\n      letter-spacing: -0.065em;\n      white-space: nowrap;\n      color: #a37a32;\n    }\n\n    @supports ((background-clip: text) or (-webkit-background-clip: text)) {\n      .dms-metal-text {\n        background-image: linear-gradient(\n          112deg,\n          #594018 0%,\n          #a98037 9%,\n          #e9cd87 17%,\n          #fff8da 22%,\n          #b48b40 28%,\n          #73501e 34%,\n          #e6c779 43%,\n          #fffbea 49%,\n          #be944a 56%,\n          #69491e 64%,\n          #d8b66b 73%,\n          #fff4ce 80%,\n          #ac8037 89%,\n          #594018 100%\n        );\n        background-size: 260% 100%;\n        background-position: 45% 50%;\n        -webkit-background-clip: text;\n        background-clip: text;\n        color: transparent;\n        -webkit-text-fill-color: transparent;\n        animation: dms-metal-flow 9s ease-in-out infinite alternate;\n        animation-play-state: paused;\n      }\n    }\n\n    .dms-golden-panel.is-visible .dms-metal-text {\n      animation-play-state: running;\n    }\n\n    .dms-metal-country {\n      display: block;\n      margin-top: 10px;\n      padding-left: 0.42em;\n      font-size: 12px;\n      font-weight: 500;\n      line-height: 1.5;\n      letter-spacing: 0.42em;\n      color: #9a7b42;\n    }\n\n    .dms-metal-rule {\n      width: 110px;\n      height: 1px;\n      margin: 12px auto 0;\n      background: linear-gradient(\n        90deg,\n        transparent,\n        #b79756,\n        transparent\n      );\n    }\n\n    .dms-golden-services {\n      max-width: 490px;\n      margin: 0 auto;\n      padding: 0;\n      list-style: none;\n      border-top: 1px solid #ded9ce;\n    }\n\n    .dms-golden-services li {\n      padding: 10px 10px;\n      border-bottom: 1px solid #ded9ce;\n      font-size: 14px;\n      font-weight: 400;\n      line-height: 20px;\n      letter-spacing: -0.3px;\n      color: #514e47;\n    }\n\n    .dms-golden-cta {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: 7px;\n      min-height: 44px;\n      margin-top: 16px;\n      padding: 10px 2px;\n      color: #256344;\n      font-size: 16px;\n      font-weight: 500;\n      line-height: 19px;\n      letter-spacing: -0.48px;\n      text-decoration: none;\n    }\n\n    .dms-golden-cta span {\n      text-decoration: underline;\n      text-underline-offset: 5px;\n      text-decoration-color: #a5b8a8;\n    }\n\n    .dms-golden-cta svg {\n      width: 16px;\n      height: 16px;\n      flex: 0 0 16px;\n      fill: none;\n      stroke: currentColor;\n      stroke-width: 1.6;\n      stroke-linecap: round;\n      stroke-linejoin: round;\n      transition: transform 200ms ease;\n    }\n\n    .dms-golden-cta:focus-visible {\n      outline: 2px solid #256344;\n      outline-offset: 5px;\n      border-radius: 3px;\n    }\n\n    @media (hover: hover) {\n      .dms-golden-cta:hover svg {\n        transform: translateX(4px);\n      }\n    }\n\n    @keyframes dms-metal-flow {\n      from {\n        background-position: 0% 50%;\n      }\n      to {\n        background-position: 100% 50%;\n      }\n    }\n\n    /* Compact mobile layout */\n    @media (max-width: 700px) {\n      .dms-golden-section {\n        padding: 16px;\n      }\n\n      .dms-golden-panel {\n        padding: 28px 16px 20px;\n        border-radius: 16px;\n      }\n\n      .dms-golden-heading {\n        font-size: 26px;\n        letter-spacing: -0.8px;\n      }\n\n      .dms-golden-heading br {\n        display: none;\n      }\n\n      .dms-golden-description {\n        margin-top: 10px;\n        font-size: 14px;\n        line-height: 21px;\n      }\n\n      .dms-metal-stage {\n        margin: 16px auto;\n      }\n\n      .dms-metal-text {\n        font-size: clamp(30px, 8.5vw, 52px);\n      }\n\n      .dms-metal-country {\n        margin-top: 8px;\n        font-size: 10px;\n      }\n\n      .dms-metal-rule {\n        margin-top: 10px;\n      }\n\n      .dms-golden-services li {\n        padding: 8px 0;\n        font-size: 12px;\n        line-height: 18px;\n      }\n\n      .dms-golden-cta {\n        margin-top: 12px;\n        font-size: 14px;\n      }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      .dms-metal-text {\n        animation: none;\n        background-position: 45% 50%;\n      }\n\n      .dms-metal-art {\n        transform: none;\n        transition: none;\n      }\n\n      .dms-golden-cta svg {\n        transition: none;\n      }\n    }\n</style>\n\n  <!-- BAHRAIN GOLDEN VISA SECTION -->\n  <section\n    class=\"dms-golden-section\"\n    aria-labelledby=\"dms-golden-heading\"\n  >\n    <div class=\"dms-golden-panel\">\n      <header>\n        <p class=\"dms-golden-eyebrow\">Bahrain Golden Visa</p>\n\n        <h2 class=\"dms-golden-heading\" id=\"dms-golden-heading\">\n          Your next chapter in Bahrain,<br>\n          with expert guidance.\n        </h2>\n\n        <p class=\"dms-golden-description\">\n          Personalised support for your Golden Visa journey,\n          from document preparation to application assistance.\n        </p>\n      </header>\n\n      <div class=\"dms-metal-stage\" aria-hidden=\"true\">\n        <div class=\"dms-metal-art\">\n          <div class=\"dms-metal-ornament\">\n            <svg viewBox=\"0 0 32 32\">\n              <path d=\"M16 2 20 12 30 16 20 20 16 30 12 20 2 16 12 12Z\"/>\n              <path d=\"M16 9v14M9 16h14\"/>\n            </svg>\n          </div>\n\n          <span class=\"dms-metal-text\">GOLDEN VISA</span>\n          <span class=\"dms-metal-country\">BAHRAIN</span>\n          <div class=\"dms-metal-rule\"></div>\n        </div>\n      </div>\n\n      <ul class=\"dms-golden-services\">\n        <li>Guidance on eligibility and application requirements</li>\n        <li>Document preparation and application assistance</li>\n        <li>Support with follow-ups throughout the process</li>\n      </ul>\n\n      <!-- Enquiry link -->\n      <a class=\"dms-golden-cta\" href=\"#contact\">\n        <span>Enquire about Bahrain Golden Visa</span>\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n          <path d=\"m9 5 7 7-7 7\"/>\n        </svg>\n      </a>\n    </div>\n  </section>\n\n<script>\n    /* DMS BAHRAIN GOLDEN VISA INTERACTIVITY */\n    (() => {\n      const panel = document.querySelector(\".dms-golden-panel\");\n      if (!panel) return;\n\n      const stage = panel.querySelector(\".dms-metal-stage\");\n\n      const reducedMotion = window.matchMedia(\n        \"(prefers-reduced-motion: reduce)\"\n      );\n\n      let inView = true;\n      let frame = 0;\n      let pointerX = 0;\n      let pointerY = 0;\n\n      function updatePlayback() {\n        panel.classList.toggle(\n          \"is-visible\",\n          inView && !document.hidden && !reducedMotion.matches\n        );\n      }\n\n      function resetTilt() {\n        cancelAnimationFrame(frame);\n        frame = 0;\n\n        stage.style.setProperty(\"--rotate-x\", \"0deg\");\n        stage.style.setProperty(\"--rotate-y\", \"0deg\");\n      }\n\n      stage.addEventListener(\"pointermove\", (event) => {\n        if (\n          event.pointerType !== \"mouse\" ||\n          reducedMotion.matches\n        ) return;\n\n        const rect = stage.getBoundingClientRect();\n\n        pointerX = (event.clientX - rect.left) / rect.width - 0.5;\n        pointerY = (event.clientY - rect.top) / rect.height - 0.5;\n\n        if (frame) return;\n\n        frame = requestAnimationFrame(() => {\n          stage.style.setProperty(\n            \"--rotate-x\",\n            `${-pointerY * 8}deg`\n          );\n\n          stage.style.setProperty(\n            \"--rotate-y\",\n            `${pointerX * 10}deg`\n          );\n\n          frame = 0;\n        });\n      });\n\n      stage.addEventListener(\"pointerleave\", resetTilt);\n\n      if (\"IntersectionObserver\" in window) {\n        const observer = new IntersectionObserver(([entry]) => {\n          inView = entry.isIntersecting;\n          updatePlayback();\n        });\n\n        observer.observe(panel);\n      }\n\n      reducedMotion.addEventListener(\"change\", () => {\n        resetTilt();\n        updatePlayback();\n      });\n\n      document.addEventListener(\"visibilitychange\", () => {\n        if (document.hidden) resetTilt();\n        updatePlayback();\n      });\n\n      updatePlayback();\n    })();\n</script>"
              }
            }
          ]
        }
      ]
    }
  ]
}